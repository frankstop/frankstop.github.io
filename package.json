{
  "dependencies": {
    "liquidjs": "^10.27.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "cheerio": "^1.2.0",
    "tailwindcss": "^3.4.19",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:site",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.css -o assets/css/styles.css --minify",
    "build:site": "bundle exec jekyll build --strict_front_matter",
    "pretest": "npm run build",
    "test": "npm run test:contracts && npm run test:e2e",
    "test:ci": "npm run test:contracts && npm run test:e2e",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e": "playwright test",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.css -o assets/css/styles.css --watch"
  }
}
